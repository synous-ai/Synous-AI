# ─────────────────────────────────────────────────────────────────────────────
# .env.example — DevDúo CRM
#
# Copiá este archivo a apps/api/.env y completá los valores.
# Las variables comentadas son opcionales; las sin comentar son REQUERIDAS.
# NUNCA commitear valores reales. Este archivo sí se commitea (sin secretos).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────────────────────
# PostgreSQL local (Docker). Puerto 5433 evita conflicto con Postgres local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/devduo_crm

# ─── Redis ───────────────────────────────────────────────────────────────────
# Usado por BullMQ (jobs/queues). Opcional: sin él los jobs no corren.
# REDIS_URL=redis://localhost:6379

# ─── Auth — Client Portal ────────────────────────────────────────────────────
# REQUERIDOS: authenticate-client.ts los usa para tokens JWT del client portal
# (client_account). NO son para el admin — el admin usa Clerk.
ACCESS_TOKEN_SECRET=cambia_esto_minimo_32_caracteres_aleatorios
REFRESH_TOKEN_SECRET=cambia_esto_minimo_32_caracteres_aleatorios
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d

# ─── Clerk — Autenticación admin (hub_user) ──────────────────────────────────
# Obtener desde https://dashboard.clerk.com → API Keys.
#
# REQUERIDA. La API no arranca sin esta clave (fail-fast Zod).
# Formato: sk_test_... en dev / sk_live_... en prod.
# NUNCA exponer al browser. NUNCA commitear el valor real.
CLERK_SECRET_KEY=sk_test_...

# Necesario para el endpoint POST /webhooks/clerk (sincronización de usuarios).
# Obtener desde Clerk Dashboard → Webhooks → tu endpoint → Signing Secret.
# Sin este valor el webhook rechaza todas las requests con 400.
# Opcional en desarrollo si no se configura el webhook todavía.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# PEM público del JWT Key de Clerk: verificación 100% offline (sin red/JWKS).
# Obtener desde Clerk Dashboard → API Keys → Show JWT Public Key.
# Si está presente, verifyToken lo usa en lugar de secretKey para evitar red.
# CLERK_JWT_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sin RESEND_API_KEY el mailer NO manda nada: loguea y sigue. Eso está bien en
# dev y en tests, pero en producción significa que el cliente nunca se entera de
# que su panel existe. En prod las dos son obligatorias.
# El dominio de FROM_EMAIL tiene que estar verificado en Resend.
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@tudominio.com

# ─── URLs (links en emails y redirects) ──────────────────────────────────────
# ADMIN_URL es la base de los links del Client Portal en los emails: el portal lo
# sirve la MISMA app Next que el admin, bajo /portal (ver apps/admin/middleware.ts).
# En producción es obligatoria si hay RESEND_API_KEY — si falta, los emails salen
# con links a localhost. La API loguea un error si detecta esa combinación.
# ADMIN_URL=http://localhost:3000
# CLIENT_PORTAL_URL sólo se usa como origin de CORS (apps/client-portal, legacy).
# NO se usa para armar los links de los emails.
# CLIENT_PORTAL_URL=http://localhost:3002
# API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001

# ─── Fathom webhook ───────────────────────────────────────────────────────────
# FATHOM_WEBHOOK_SECRET=

# ─── Google Maps (módulo de prospección) ─────────────────────────────────────
# GOOGLE_MAPS_API_KEY=

# ─── Vertex AI / Gemini (setter + análisis de leads) ─────────────────────────
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# VERTEX_LOCATION=global
# VERTEX_MODEL=gemini-3.1-pro-preview

# ─── Anthropic / Claude (setter — segundo provider del Model Switcher) ────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Evolution API (WhatsApp — canal del setter) ──────────────────────────────
# EVOLUTION_API_URL=https://tu-evolution.app
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=devduo
# EVOLUTION_WEBHOOK_SECRET=

# ─── Google Calendar (booking del setter) ─────────────────────────────────────
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_ID=

# ─── Clerk — Autenticación del panel admin (hub_user) ───────────────────────
# Obtener desde el Clerk Dashboard: https://dashboard.clerk.com
#
# Publishable key (empieza con pk_test_ en dev, pk_live_ en prod).
# Expuesta al browser; sin riesgo si se filtra.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key (empieza con sk_test_ en dev, sk_live_ en prod).
# NUNCA exponer al browser ni commitear.
CLERK_SECRET_KEY=sk_test_...

# ─── URLs de Clerk (rutas internas del admin) ────────────────────────────────
# Dónde redirige Clerk cuando el usuario no está autenticado.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login

# Ruta post-login si Clerk no tiene un destino previo.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/dashboard

# ─── API ─────────────────────────────────────────────────────────────────────
# URL de la Fastify API. En desarrollo local siempre es http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── White-label / multi-tenant (opcional) ───────────────────────────────────
# Dominio raíz para resolución de subdominios en producción.
# Ej: si la app corre en app.devduo.com, esto sería "devduo.com".
# En dev con *.localhost no hace falta setearlo.
# NEXT_PUBLIC_ROOT_DOMAIN=devduo.com
